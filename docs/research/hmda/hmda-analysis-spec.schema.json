{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairlendkit.example/schemas/hmda-analysis-spec.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "manifest_kind", "schema_version", "contract_id", "global_order", "raw_to_analysis_mappings", "estimands", "multiplicity"],
  "properties": {
    "$schema": {"const": "./hmda-analysis-spec.schema.json"}, "manifest_kind": {"const": "analysis_spec"},
    "schema_version": {"const": "1.0.0"}, "contract_id": {"const": "HMDA-CA-2024-CD-V1"},
    "global_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "raw_to_analysis_mappings": {"type": "object", "minProperties": 2},
    "estimands": {"type": "object", "additionalProperties": false, "required": ["unadjusted", "standardized", "regression_adjusted"], "properties": {
      "unadjusted": {"$ref": "#/$defs/estimand"}, "standardized": {"$ref": "#/$defs/estimand"},
      "regression_adjusted": {"allOf": [{"$ref": "#/$defs/estimand"}, {"properties": {"row_set": {"properties": {"id": {"const": "regression_support_only"}}}}}]}
    }},
    "multiplicity": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "row_set": {"type": "object", "required": ["id", "start", "complete_case_fields"], "properties": {
      "id": {"type": "string", "minLength": 1}, "start": {"type": "string", "minLength": 1},
      "complete_case_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "complete_case_rules": {"type": "object"}, "then": {"type": "string"}, "support": {"type": "string"}
    }, "additionalProperties": false},
    "estimand": {"type": "object", "required": ["row_set", "formula", "variance", "p_value", "failure_reason_codes"],
      "properties": {
        "row_set": {"$ref": "#/$defs/row_set"}, "formula": {"type": "string", "minLength": 1},
        "variance": {"type": "object", "minProperties": 1}, "p_value": {"type": "string", "minLength": 1},
        "failure_reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "stratum_key": {"type": "array"}, "bins": {"type": "object"}, "support": {"type": "object"},
        "target": {"type": "string"}, "model_family": {"type": "string"}, "interactions": {"type": "array"},
        "county_in_primary_model": {"type": "boolean"}, "lei_in_primary_model": {"type": "boolean"}, "contrast": {"type": "string"}
      }, "additionalProperties": false}
  }
}
