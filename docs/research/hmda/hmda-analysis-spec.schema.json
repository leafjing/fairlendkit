{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairlendkit.example/schemas/hmda-analysis-spec.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "manifest_type", "schema_version", "contract_id", "global_order", "raw_to_analysis_mappings", "estimands", "multiplicity"],
  "properties": {
    "$schema": {"const": "./hmda-manifest-schema-v2.json"}, "manifest_type": {"const": "analysis_spec"},
    "schema_version": {"const": "1.0.0"}, "contract_id": {"const": "HMDA-CA-2024-CD-V1"},
    "global_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "raw_to_analysis_mappings": {"type": "object", "additionalProperties": false, "required": ["dti_band", "applicant_age", "cltv_band"], "properties": {"dti_band": {"$ref": "#/$defs/category_map"}, "applicant_age": {"$ref": "#/$defs/category_map"}, "cltv_band": {"$ref": "#/$defs/category_map"}}},
    "estimands": {"type": "object", "additionalProperties": false, "required": ["unadjusted", "standardized", "regression_adjusted"], "properties": {
      "unadjusted": {"$ref": "#/$defs/estimand"}, "standardized": {"$ref": "#/$defs/estimand"},
      "regression_adjusted": {"allOf": [{"$ref": "#/$defs/estimand"}, {"properties": {"row_set": {"properties": {"id": {"const": "regression_support_only"}}}}}]}
    }},
    "multiplicity": {"type": "object", "additionalProperties": false, "required": ["family_definition", "method", "input", "algorithm", "undefined_policy"], "properties": {"family_definition": {"type": "string"}, "method": {"const": "holm_step_down"}, "input": {"type": "string"}, "algorithm": {"type": "string"}, "undefined_policy": {"type": "string"}}}
  },
  "$defs": {
    "row_set": {"type": "object", "required": ["id", "start", "complete_case_fields"], "properties": {
      "id": {"type": "string", "minLength": 1}, "start": {"type": "string", "minLength": 1},
      "complete_case_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "complete_case_rules": {"type": "object", "additionalProperties": false, "properties": {"loan_amount": {"type": "string"}, "income": {"type": "string"}, "debt_to_income_ratio": {"type": "string"}, "combined_loan_to_value_ratio": {"type": "string"}, "property_value": {"type": "string"}, "loan_term": {"type": "string"}, "applicant_age": {"type": "string"}}}, "then": {"type": "string"}, "support": {"type": "string"}
    }, "additionalProperties": false},
    "estimand": {"type": "object", "required": ["row_set", "formula", "variance", "p_value", "failure_reason_codes"],
      "properties": {
        "row_set": {"$ref": "#/$defs/row_set"}, "formula": {"type": "string", "minLength": 1},
        "variance": {"$ref": "#/$defs/variance"}, "p_value": {"type": "string", "minLength": 1},
        "failure_reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "stratum_key": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "bins": {"$ref": "#/$defs/bins"}, "support": {"$ref": "#/$defs/support"},
        "target": {"type": "string"}, "model_family": {"type": "string"}, "interactions": {"type": "array"},
        "county_in_primary_model": {"type": "boolean"}, "lei_in_primary_model": {"type": "boolean"}, "contrast": {"type": "string"}
      }, "additionalProperties": false},
    "category_map": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "null"]}},
    "bins": {"type": "object", "additionalProperties": false, "properties": {"income_band": {"$ref": "#/$defs/string_array"}, "loan_amount_band": {"$ref": "#/$defs/string_array"}, "dti_band": {"$ref": "#/$defs/string_array"}, "cltv_band": {"$ref": "#/$defs/string_array"}}},
    "support": {"type": "object", "additionalProperties": false, "properties": {"minimum_rows_per_group_per_stratum": {"type": "integer"}, "minimum_favorable_per_group_per_stratum": {"type": "integer"}, "minimum_unfavorable_per_group_per_stratum": {"type": "integer"}, "minimum_retained_fraction_each_group": {"type": "number"}, "minimum_overall_supported_fraction": {"type": "number"}, "minimum_supported_strata": {"type": "integer"}, "stratum_key_and_thresholds": {"type": "string"}, "row_set_digest_must_differ_if_input_membership_differs": {"type": "boolean"}}},
    "variance": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"rate_ci": {"type": "string"}, "difference_ci": {"type": "string"}, "ratio_ci": {"type": "string"}, "method": {"type": "string"}, "replicates": {"type": "integer"}, "seed": {"type": "integer"}, "ci": {"type": "string"}, "minimum_valid_replicates": {"type": "integer"}, "support_reapplied_each_replicate": {"type": "boolean"}, "minimum_lender_clusters": {"type": "integer"}}},
    "string_array": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
