{
  "$schema": "./hmda-manifest-schema-v1.json",
  "manifest_kind": "control_manifest",
  "schema_version": "1.0.0",
  "contract_id": "HMDA-CA-2024-CD-V1",
  "primary_regression_formula": "favorable_action ~ protected_group + log1p_loan_amount + log1p_income + C(dti_band,Treatment(reference='<30')) + C(cltv_band,Treatment(reference='[0,60]')) + log1p_property_value + loan_term_months + C(applicant_age,Treatment(reference='35-44'))",
  "primary_regression_interactions": [],
  "primary_regression_regularization": "none",
  "primary_regression_population": "hmda_regression_supported_rows_v1",
  "variables": [
    {"field": "loan_amount", "role": "core_control", "coding": "log1p(decimal_dollars)", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified requested credit scale", "allowed_analyses": ["standardized", "primary_regression"], "reference_category": null},
    {"field": "income", "role": "core_control", "coding": "per_estimand_analysis_spec", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified applicant resources measure with known limitations", "allowed_analyses": ["standardized", "primary_regression"], "reference_category": null},
    {"field": "debt_to_income_ratio", "role": "core_control", "coding": "dti_band_from_analysis_spec", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified disclosed obligation ratio", "allowed_analyses": ["standardized", "primary_regression"], "reference_category": "<30"},
    {"field": "combined_loan_to_value_ratio", "role": "core_control", "coding": "cltv_band_from_analysis_spec", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified secured-credit leverage measure", "allowed_analyses": ["standardized", "primary_regression"], "reference_category": "[0,60]"},
    {"field": "property_value", "role": "core_control", "coding": "log1p(decimal_dollars)", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified property scale", "allowed_analyses": ["primary_regression"], "reference_category": null},
    {"field": "loan_term", "role": "core_control", "coding": "integer_months", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified product term", "allowed_analyses": ["primary_regression"], "reference_category": null},
    {"field": "applicant_age", "role": "core_control", "coding": "published_category_identity", "missing_rule": "per_estimand_analysis_spec", "rationale": "prespecified life-cycle band; no continuous age reconstruction", "allowed_analyses": ["primary_regression"], "reference_category": "35-44"},
    {"field": "county_code", "role": "sensitivity_only", "coding": "categorical_fips_sum_to_zero", "missing_rule": "NA allowed statewide; excluded from county sensitivity", "rationale": "geographic heterogeneity, not primary adjustment", "allowed_analyses": ["HMDA-SENS-CONTROL-EXTENDED", "HMDA-SENS-GEOGRAPHY"], "reference_category": null},
    {"field": "lei", "role": "cluster_and_sensitivity_only", "coding": "categorical_lei_sum_to_zero", "missing_rule": "invalid LEI fails source row", "rationale": "lender dependence and named lender sensitivity", "allowed_analyses": ["variance_cluster", "HMDA-SENS-LENDER"], "reference_category": null},
    {"field": "activity_year", "role": "cohort_constant", "coding": "exact_2024", "missing_rule": "exclude cohort", "rationale": "source year", "allowed_analyses": [], "reference_category": null},
    {"field": "state_code", "role": "cohort_constant", "coding": "exact_CA", "missing_rule": "exclude cohort", "rationale": "frozen geography", "allowed_analyses": [], "reference_category": null},
    {"field": "loan_type", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen conventional cohort", "allowed_analyses": [], "reference_category": null},
    {"field": "lien_status", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen first-lien cohort", "allowed_analyses": [], "reference_category": null},
    {"field": "loan_purpose", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen purchase cohort", "allowed_analyses": [], "reference_category": null},
    {"field": "occupancy_type", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen owner-occupied cohort", "allowed_analyses": [], "reference_category": null},
    {"field": "construction_method", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen site-built cohort", "allowed_analyses": [], "reference_category": null},
    {"field": "total_units", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen one-unit cohort", "allowed_analyses": [], "reference_category": null},
    {"field": "action_taken", "role": "outcome", "coding": "primary 1/2 favorable, 3 unfavorable", "missing_rule": "exclude cohort", "rationale": "decision outcome", "allowed_analyses": ["outcome_only"], "reference_category": "3"},
    {"field": "derived_ethnicity", "role": "protected_group", "coding": "exact_published_category", "missing_rule": "retain in flow; exclude outside named contrast", "rationale": "group definition", "allowed_analyses": ["ethnicity_contrast"], "reference_category": "Not Hispanic or Latino"},
    {"field": "derived_race", "role": "protected_group", "coding": "exact_published_category", "missing_rule": "retain in flow; exclude outside named contrast", "rationale": "group definition", "allowed_analyses": ["race_contrast"], "reference_category": "White"},
    {"field": "derived_sex", "role": "protected_group", "coding": "exact_published_category", "missing_rule": "retain in flow; exclude outside named contrast", "rationale": "group definition", "allowed_analyses": ["sex_contrast"], "reference_category": "Male"}
  ],
  "prohibited_field_patterns": ["denial_reason*", "rate_spread", "interest_rate", "prepayment_penalty_term", "origination_charges", "discount_points", "lender_credits", "total_loan_costs", "total_points_and_fees", "hoepa_status", "purchaser_type"],
  "unavailable_concepts": ["complete_credit_history", "verified_assets", "lender_model_score", "fraud_indicators", "pricing_exceptions", "detailed_underwriting_judgment"]
}
