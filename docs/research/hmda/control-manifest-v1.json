{
  "schema_version": "1.0.0",
  "contract_id": "HMDA-CA-2024-CD-V1",
  "primary_regression_formula": "favorable_action ~ protected_group + log1p_loan_amount + log1p_income + C(dti_band, Treatment(reference='<30')) + C(cltv_band, Treatment(reference='[0,60]')) + log1p_property_value + loan_term_months + C(applicant_age, Treatment(reference='35-44'))",
  "primary_regression_interactions": [],
  "primary_regression_regularization": "none",
  "primary_regression_population": "adjusted_common_support_rows",
  "variables": [
    {"field": "loan_amount", "role": "core_control", "coding": "log1p(decimal_dollars)", "missing_rule": "NA, Exempt, invalid, or <=0 excludes adjusted row", "rationale": "prespecified requested credit scale", "allowed_analyses": ["standardized_support_base", "primary_regression"]},
    {"field": "income", "role": "core_control", "coding": "log1p(decimal_thousands)", "missing_rule": "NA, Exempt, invalid, or <=0 excludes adjusted row", "rationale": "prespecified applicant resources measure with known limitations", "allowed_analyses": ["standardized_support_base", "primary_regression"]},
    {"field": "debt_to_income_ratio", "role": "core_control", "coding": "dti_band", "missing_rule": "NA excludes adjusted row; Exempt is a modeled category", "rationale": "prespecified disclosed obligation ratio", "allowed_analyses": ["standardized_stratum", "primary_regression"]},
    {"field": "combined_loan_to_value_ratio", "role": "core_control", "coding": "cltv_band", "missing_rule": "NA/invalid excludes adjusted row; Exempt is a modeled category", "rationale": "prespecified secured-credit leverage measure", "allowed_analyses": ["standardized_stratum", "primary_regression"]},
    {"field": "property_value", "role": "core_control", "coding": "log1p(decimal_dollars)", "missing_rule": "NA, Exempt, invalid, or <=0 excludes adjusted row", "rationale": "prespecified property scale", "allowed_analyses": ["standardized_support_base", "primary_regression"]},
    {"field": "loan_term", "role": "core_control", "coding": "integer_months", "missing_rule": "NA, Exempt, invalid, or outside [1,600] excludes adjusted row", "rationale": "prespecified product term", "allowed_analyses": ["standardized_support_base", "primary_regression"]},
    {"field": "applicant_age", "role": "core_control", "coding": "published_category", "missing_rule": "8888 and 9999 exclude adjusted row", "rationale": "prespecified life-cycle band; no continuous age reconstruction", "allowed_analyses": ["standardized_support_base", "primary_regression"]},
    {"field": "county_code", "role": "sensitivity_only", "coding": "categorical_fips", "missing_rule": "NA allowed statewide; excluded from county sensitivity", "rationale": "geographic heterogeneity, not primary adjustment", "allowed_analyses": ["HMDA-SENS-GEOGRAPHY"]},
    {"field": "lei", "role": "cluster_and_sensitivity_only", "coding": "categorical_lei", "missing_rule": "invalid LEI fails source row", "rationale": "lender dependence and named lender sensitivity", "allowed_analyses": ["variance_cluster", "HMDA-SENS-LENDER"]},
    {"field": "activity_year", "role": "cohort_constant", "coding": "exact_2024", "missing_rule": "exclude cohort", "rationale": "source year", "allowed_analyses": []},
    {"field": "state_code", "role": "cohort_constant", "coding": "exact_CA", "missing_rule": "exclude cohort", "rationale": "frozen geography", "allowed_analyses": []},
    {"field": "loan_type", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen conventional cohort", "allowed_analyses": []},
    {"field": "lien_status", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen first-lien cohort", "allowed_analyses": []},
    {"field": "loan_purpose", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen purchase cohort", "allowed_analyses": []},
    {"field": "occupancy_type", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen owner-occupied cohort", "allowed_analyses": []},
    {"field": "construction_method", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen site-built cohort", "allowed_analyses": []},
    {"field": "total_units", "role": "cohort_constant", "coding": "exact_1", "missing_rule": "exclude cohort", "rationale": "frozen one-unit cohort", "allowed_analyses": []},
    {"field": "action_taken", "role": "outcome", "coding": "primary 1/2 favorable, 3 unfavorable", "missing_rule": "exclude cohort", "rationale": "decision outcome", "allowed_analyses": ["outcome_only"]},
    {"field": "derived_ethnicity", "role": "protected_group", "coding": "exact_published_category", "missing_rule": "retain in flow; exclude outside named contrast", "rationale": "group definition", "allowed_analyses": ["ethnicity_contrast"]},
    {"field": "derived_race", "role": "protected_group", "coding": "exact_published_category", "missing_rule": "retain in flow; exclude outside named contrast", "rationale": "group definition", "allowed_analyses": ["race_contrast"]},
    {"field": "derived_sex", "role": "protected_group", "coding": "exact_published_category", "missing_rule": "retain in flow; exclude outside named contrast", "rationale": "group definition", "allowed_analyses": ["sex_contrast"]}
  ],
  "prohibited_field_patterns": ["denial_reason*", "rate_spread", "interest_rate", "prepayment_penalty_term", "origination_charges", "discount_points", "lender_credits", "total_loan_costs", "total_points_and_fees", "hoepa_status", "purchaser_type"],
  "unavailable_concepts": ["complete_credit_history", "verified_assets", "lender_model_score", "fraud_indicators", "pricing_exceptions", "detailed_underwriting_judgment"]
}
