{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairlendkit.example/schemas/hmda-control-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifest_type", "schema_version", "contract_id", "primary_regression_formula", "primary_regression_interactions", "primary_regression_population", "primary_regression_regularization", "variables", "prohibited_field_patterns", "unavailable_concepts"],
  "properties": {
    "$schema": {"const": "./hmda-manifest-schema-v2.json"},
    "manifest_type": {"const": "control_manifest"},
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "HMDA-CA-2024-CD-V1"},
    "primary_regression_formula": {"type": "string", "minLength": 1},
    "primary_regression_interactions": {"type": "array", "items": {"type": "string"}},
    "primary_regression_population": {"const": "regression_support_only"},
    "primary_regression_regularization": {"type": "string", "minLength": 1},
    "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}},
    "prohibited_field_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unavailable_concepts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "variable": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "role", "coding", "missing_rule", "rationale", "allowed_analyses", "reference_category"],
      "properties": {
        "field": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
        "coding": {"type": "string", "minLength": 1}, "missing_rule": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "allowed_analyses": {"type": "array", "items": {"enum": ["HMDA-SENS-CONTROL-EXTENDED", "HMDA-SENS-GEOGRAPHY", "HMDA-SENS-LENDER", "ethnicity_contrast", "outcome_only", "primary_regression", "race_contrast", "sex_contrast", "standardized", "variance_cluster"]}, "uniqueItems": true},
        "reference_category": {"type": ["string", "null"]},
        "contrast_coding": {"const": "sum_to_zero"}
      },
      "allOf": [{"if": {"properties": {"field": {"enum": ["county_code", "lei"]}}, "required": ["field"]}, "then": {"required": ["contrast_coding"], "properties": {"reference_category": {"type": "null"}}}}]
    }
  }
}
