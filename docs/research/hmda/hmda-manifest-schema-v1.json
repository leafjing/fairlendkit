{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairlendkit.example/schemas/hmda-manifest-schema-v1.json",
  "title": "FairLendKit HMDA implementation manifest envelope",
  "type": "object",
  "required": ["manifest_kind", "schema_version", "contract_id"],
  "properties": {
    "manifest_kind": {"enum": ["field_rules", "control_manifest", "analysis_spec", "sensitivity_spec"]},
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "HMDA-CA-2024-CD-V1"}
  },
  "$defs": {
    "row_set": {
      "type": "object",
      "required": ["id", "start", "complete_case_fields"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "complete_case_fields": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "complete_case_rules": {"type": "object"},
        "support": {"type": "string"},
        "then": {"type": "string"}
      }
    },
    "estimand": {
      "type": "object",
      "required": ["row_set", "formula", "variance", "p_value", "failure_reason_codes"],
      "properties": {
        "row_set": {"$ref": "#/$defs/row_set"},
        "formula": {"type": ["string", "object"]},
        "variance": {"type": "object", "minProperties": 1},
        "p_value": {"type": "string", "minLength": 1},
        "failure_reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "control_variable": {
      "type": "object",
      "required": ["field", "role", "coding", "missing_rule", "rationale", "allowed_analyses", "reference_category"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "coding": {"type": "string", "minLength": 1},
        "missing_rule": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "allowed_analyses": {"type": "array", "items": {"type": "string"}},
        "reference_category": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "sensitivity": {
      "type": "object",
      "required": ["id", "estimands", "outcome", "complete_case", "formula", "regression_formula", "reference_categories", "bins", "support", "variance", "p_value"],
      "properties": {
        "id": {"type": "string", "pattern": "^HMDA-SENS-"},
        "status": {"type": "string"},
        "estimands": {"type": "array", "items": {"enum": ["unadjusted", "standardized", "regression_adjusted"]}},
        "outcome": {"type": "object", "required": ["favorable", "unfavorable"]},
        "complete_case": {"type": "object"},
        "formula": {"type": "object"},
        "regression_formula": {"type": ["string", "null"]},
        "reference_categories": {"type": "object"},
        "bins": {"type": "object"},
        "support": {"type": "object"},
        "variance": {"type": "object"},
        "p_value": {"type": "object"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"manifest_kind": {"const": "field_rules"}}}, "then": {"required": ["source_sha256", "normalization", "required_fields", "ordered_cohort_rules", "outcomes", "group_contrasts"]}},
    {"if": {"properties": {"manifest_kind": {"const": "control_manifest"}}}, "then": {"required": ["primary_regression_formula", "primary_regression_population", "variables", "prohibited_field_patterns", "unavailable_concepts"], "properties": {"variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control_variable"}}}}},
    {"if": {"properties": {"manifest_kind": {"const": "analysis_spec"}}}, "then": {"required": ["global_order", "raw_to_analysis_mappings", "estimands", "multiplicity"], "properties": {"estimands": {"type": "object", "required": ["unadjusted", "standardized", "regression_adjusted"], "properties": {"unadjusted": {"$ref": "#/$defs/estimand"}, "standardized": {"$ref": "#/$defs/estimand"}, "regression_adjusted": {"$ref": "#/$defs/estimand"}}}}}},
    {
      "if": {"properties": {"manifest_kind": {"const": "sensitivity_spec"}}},
      "then": {
        "required": ["analyses"],
        "properties": {
          "analyses": {
            "type": "array",
            "minItems": 10,
            "items": {
              "$ref": "#/$defs/sensitivity"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
